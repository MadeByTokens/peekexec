[Unit]
Description=peekexec request socket

[Socket]
ListenStream=/run/peekexec/peekexec.sock
# Only administrators may connect: install.sh adds a drop-in
# (peekexecd.socket.d/admin-group.conf) setting SocketGroup to the group named
# at install. The daemon checks again, against this socket's group.
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
