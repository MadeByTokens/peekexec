<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>peekexec</vendor>
  <!-- Used by peekexecd when it cannot verify the display its own dialog is
       on (Wayland): the desktop's polkit agent asks for the password. The
       message shown is the request summary peekexecd passes in. Never
       remembered: every request asks again. Only for the active local
       session: polkit itself refuses anything else (ssh, an inactive
       console), as peekexecd already does. A process in no session
       (user@.service apps) is judged by the user's display session. The
       user's own password (auth_self): peekexecd already requires an
       administrator, as with its own dialog. A local rule that returns yes
       for this action makes peekexecd refuse: no human would be asked. -->
  <action id="org.peekexec.approve">
    <description>Approve a peekexec request</description>
    <message>peekexec request. If this line is all you see, cancel: the request is not shown.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
