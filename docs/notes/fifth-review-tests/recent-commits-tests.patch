+    #[test]
+    fn vp_a_reused_pid_does_not_join_the_chain() {
+        use std::cell::Cell;
+        // Requester 300 (started 300), child of intermediate 200 (started
+        // 200). Unrelated to the agent 100 (started 100). After the walk has
+        // accepted 200, it exits and pid 200 is reused by a child of the
+        // agent, so /proc/200/stat now reads ppid 100, started 900.
+        let accepted = Cell::new(false);
+        let reads = Cell::new(0);
+        let parent = |pid: u32| match pid {
+            300 => {
+                reads.set(reads.get() + 1);
+                if reads.get() == 2 {
+                    accepted.set(true); // the re-read that accepts 200
+                }
+                Some(200)
+            }
+            200 if accepted.get() => Some(100), // pid 200 reused
+            200 => Some(50),
+            _ => None,
+        };
+        let info = |pid: u32| ProcessInfo {
+            pid,
+            exe: None,
+            cmdline: vec![],
+            start_time: Some(match pid {
+                200 if accepted.get() => 900,
+                p => p as u64,
+            }),
+        };
+        let chain: Vec<u32> = walk((300, Some(300)), parent, info)
+            .iter()
+            .map(|p| p.pid)
+            .collect();
+        assert!(!chain.contains(&100), "joined the agent: {chain:?}");
+    }
